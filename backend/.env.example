# ===========================================
# REQUIRED — Application will not start without these
# ===========================================

# Supabase project URL (from supabase.com dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (NOT the anon key)
# Found in: Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# ENVIRONMENT
# ===========================================
ENVIRONMENT=development
DEBUG=false

# ===========================================
# LLM PROVIDERS — At least one required for AI features
# ===========================================

# Groq (fast inference, free tier available)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (multi-model gateway)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Together AI
TOGETHER_API_KEY=

# NVIDIA NIM (legacy fallback)
NVIDIA_API_KEY=

# ===========================================
# EMBEDDING — Required for match scoring
# ===========================================

# Cohere (embed-english-v3.0)
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ===========================================
# EMAIL — Optional, for application notifications
# ===========================================

# Resend (recommended)
# Get key: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=PAU Interconnect <onboarding@resend.dev>

# ===========================================
# SECURITY
# ===========================================

# Frontend URL for CORS. Use comma-separated for multiple origins.
# NEVER use '*' in production.
FRONTEND_URL=http://localhost:3000

# Comma-separated admin emails (bypasses DB role check)
ADMIN_EMAILS=

# ===========================================
# INFRASTRUCTURE — Optional
# ===========================================

# Redis for caching (falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379

# ===========================================
# TUNING — Optional (defaults shown)
# ===========================================

# LLM_TIMEOUT=30.0
# EMBEDDING_TIMEOUT=30.0
# DB_TIMEOUT=15.0
# CV_PROCESSING_CONCURRENCY=5
# MAX_CONCURRENT_STREAMS=50
# EMBEDDING_CACHE_SIZE=2000
# EMBEDDING_CACHE_TTL=86400
# MATCH_CACHE_SIZE=5000
# MATCH_CACHE_TTL=3600
