# ==============================================================================
# PAU Interconnect Frontend Environment Variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Required: Supabase Project Configuration (anon key is safe for client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: FastAPI Backend URL (defaults to http://localhost:8000 in dev)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: Public Application URL for links in emails (e.g. https://interconnect-ten.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Auth Redirect URL after sign-up confirmation
NEXT_PUBLIC_AUTH_SIGNUP_REDIRECT_URL=http://localhost:3000/dashboard

# Optional: Transactional Email (Brevo is primary free-tier provider, Resend fallback)
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@pau.edu.ng
EMAIL_FROM_NAME="PAU Interconnect"

# Optional: Dev Toolbar & Mock Mode
NEXT_PUBLIC_ENABLE_DEV_TOOLBAR=false
NEXT_PUBLIC_ENABLE_DEV_MOCK_MODE=false
